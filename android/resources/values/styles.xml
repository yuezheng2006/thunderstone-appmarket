<?xml version="1.0" encoding="utf-8"?>
<!-- ThunderStone 应用市场 - 样式系统 -->
<resources>
    <!-- 文字样式 -->
    <style name="TextAppearance.ThunderStone" parent="android:TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="TextAppearance.ThunderStone.Display">
        <item name="android:textSize">@dimen/text_4xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="TextAppearance.ThunderStone.Headline">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="TextAppearance.ThunderStone.Title">
        <item name="android:textSize">@dimen/text_xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="TextAppearance.ThunderStone.Body">
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="TextAppearance.ThunderStone.BodySecondary">
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:textColor">@color/fg_secondary</item>
    </style>

    <style name="TextAppearance.ThunderStone.Caption">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/fg_tertiary</item>
    </style>

    <style name="TextAppearance.ThunderStone.Small">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/fg_tertiary</item>
    </style>

    <!-- 按钮样式 -->
    <style name="Button.ThunderStone" parent="android:Widget.Button">
        <item name="android:minHeight">@dimen/btn_height_default</item>
        <item name="android:minWidth">@dimen/btn_min_width</item>
        <item name="android:paddingStart">@dimen/btn_padding_h</item>
        <item name="android:paddingEnd">@dimen/btn_padding_h</item>
        <item name="android:paddingTop">@dimen/btn_padding_v</item>
        <item name="android:paddingBottom">@dimen/btn_padding_v</item>
        <item name="android:textSize">@dimen/text_base</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">@dimen/elevation_sm</item>
    </style>

    <style name="Button.ThunderStone.Primary">
        <item name="android:background">@drawable/bg_button_primary_gradient</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Button.ThunderStone.Accent">
        <item name="android:background">@drawable/bg_accent_gradient</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Button.ThunderStone.Danger">
        <item name="android:background">@drawable/bg_danger_gradient</item>
        <item name="android:textColor">@color/fg</item>
    </style>

    <style name="Button.ThunderStone.Ghost">
        <item name="android:background">@color/transparent</item>
        <item name="android:textColor">@color/fg_secondary</item>
    </style>

    <style name="Button.ThunderStone.Small">
        <item name="android:minHeight">@dimen/btn_height_small</item>
        <item name="android:textSize">@dimen/text_sm</item>
    </style>

    <!-- 卡片样式 -->
    <style name="Card.ThunderStone">
        <item name="android:background">@color/surface</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_margin">@dimen/card_margin</item>
        <item name="android:elevation">@dimen/elevation_md</item>
    </style>

    <style name="Card.ThunderStone.Elevated">
        <item name="android:background">@color/surface_elevated</item>
        <item name="android:elevation">@dimen/elevation_lg</item>
    </style>

    <!-- 应用图标样式 -->
    <style name="AppIcon.ThunderStone">
        <item name="android:layout_width">@dimen/app_icon_default</item>
        <item name="android:layout_height">@dimen/app_icon_default</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="AppIcon.ThunderStone.Small">
        <item name="android:layout_width">@dimen/app_icon_small</item>
        <item name="android:layout_height">@dimen/app_icon_small</item>
    </style>

    <style name="AppIcon.ThunderStone.Large">
        <item name="android:layout_width">@dimen/app_icon_large</item>
        <item name="android:layout_height">@dimen/app_icon_large</item>
    </style>

    <!-- UI 图标样式 -->
    <style name="Icon.ThunderStone">
        <item name="android:layout_width">@dimen/ui_icon_default</item>
        <item name="android:layout_height">@dimen/ui_icon_default</item>
        <item name="android:tint">@color/fg_secondary</item>
    </style>

    <style name="Icon.ThunderStone.Small">
        <item name="android:layout_width">@dimen/ui_icon_small</item>
        <item name="android:layout_height">@dimen/ui_icon_small</item>
    </style>

    <style name="Icon.ThunderStone.Large">
        <item name="android:layout_width">@dimen/ui_icon_large</item>
        <item name="android:layout_height">@dimen/ui_icon_large</item>
    </style>

    <!-- Divider 分割线样式 -->
    <style name="Divider.ThunderStone">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/border_thin</item>
        <item name="android:background">@color/border</item>
    </style>

    <style name="Divider.ThunderStone.Strong">
        <item name="android:background">@color/border_strong</item>
    </style>
</resources>
