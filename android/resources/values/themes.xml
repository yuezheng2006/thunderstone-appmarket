<?xml version="1.0" encoding="utf-8"?>
<!-- ThunderStone 应用市场 - 主题系统 -->
<resources>
    <!-- 基础主题 - 深蓝海外风格 -->
    <style name="Theme.ThunderStone" parent="android:Theme.Material.NoActionBar">
        <!-- 窗口背景 -->
        <item name="android:windowBackground">@color/bg</item>
        
        <!-- 状态栏和导航栏 -->
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- 主色系统 -->
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_pressed</item>
        <item name="android:colorAccent">@color/accent</item>
        
        <!-- 文字颜色 -->
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_secondary</item>
        <item name="android:textColorTertiary">@color/fg_tertiary</item>
        
        <!-- 默认字体 -->
        <item name="android:fontFamily">sans-serif</item>
        
        <!-- 控件颜色 -->
        <item name="android:colorControlNormal">@color/fg_secondary</item>
        <item name="android:colorControlActivated">@color/primary</item>
        <item name="android:colorControlHighlight">@color/primary_hover</item>
        
        <!-- 按钮样式 -->
        <item name="android:buttonStyle">@style/Button.ThunderStone</item>
    </style>

    <!-- TV Leanback 主题 -->
    <style name="Theme.ThunderStone.Leanback" parent="android:Theme.Leanback">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/accent</item>
        
        <!-- Leanback 特定属性 -->
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
    </style>

    <!-- 全屏主题 -->
    <style name="Theme.ThunderStone.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 对话框主题 -->
    <style name="Theme.ThunderStone.Dialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@color/surface_elevated</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
</resources>
